# The repo's credentials and settings. Copy to .env (never committed): cp env.example .env
# The makefiles read .env when there is one; on GitHub the same names are the repo's secrets.

# Google Cloud: Cloud Vision for scanned pages, Gemini by Vertex batch (application default credentials:
# gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
# where the model batches' requests and answers go: gs://<bucket>/batches
DOCFLOW_BATCH_BUCKET=

# IndicOCR (Bodhan AI) on our gateway: the pages build_doc_ reads whole by OCR (orgpedia/doc docflow.md §T5). By
# batch, its images go into a Modal Volume with the Modal SDK: the Modal token too (docflow.md §P11b)
OCR_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# HuggingFace: the dataset the records and PDFs come from (make list_all, make pull). Reading a public dataset needs
# no token; pushing (later) does.
HF_DATASET=Orgpedia/mahGRs
HF_TOKEN=
